# Required — used for the Gemini LLM, embeddings, and Google TTS
GOOGLE_API_KEY=

# Optional — second Gemini key with its own quota. tests/generation-test.js
# retries the same model on this key before falling back to a weaker model,
# effectively doubling daily quota per model during test runs.
GOOGLE_API_KEY_SECONDARY=

# Optional — separate key for Google Cloud TTS; falls back to GOOGLE_API_KEY if unset
GOOGLE_TTS_API_KEY=

# Required for tests/generation-test.js and the test campaign — DeepSeek is
# the default LLM judge (a different model family from the Gemini generator),
# to avoid same-family confirmation bias on top of self-enhancement bias. Get
# a key at platform.deepseek.com. Not used by the live server.
DEEPSEEK_API_KEY=

# ── Context mode ─────────────────────────────────────────────────────────────
# Controls how ADAS knowledge is provided to the LLM.
#   rag          — retrieve only relevant chunks via similarity search (default)
#   full-fixed   — all docs in the prompt, alphabetical order (deterministic baseline)
#   full-ordered — all docs in the prompt, most question-relevant docs first
#   none         — ungrounded baseline: no retrieval, no documents; model answers
#                  from its own trained knowledge, told it's about BMW's ADAS systems
CONTEXT_MODE=rag

# ── Knowledge mode ────────────────────────────────────────────────────────────
# Controls how student knowledge is tracked and displayed per topic.
#   descriptions — free-text summary of what the student knows (default); sidebar shows a sentence
#   scores       — 3 tiers: 0=Beginner, 1=Intermediate, 2=Expert; sidebar shows a progress bar
KNOWLEDGE_MODE=descriptions

# ── Embedding model ───────────────────────────────────────────────────────────
# Used by rag:embed (building the vector store) and during retrieval at runtime.
# Must match between embed and serve — changing this requires re-running rag:embed.
EMBEDDING_MODEL=gemini-embedding-001

# ── LLM model chain ───────────────────────────────────────────────────────────
# Comma-separated Gemini chat models tried in order, most capable first.
# On a 429/503 every chat call falls through to the next model.
# Default: gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite
LLM_MODEL_CHAIN=

# Single model, no fallback — only used if LLM_MODEL_CHAIN is unset
LLM_MODEL=

# Generation temperature (default 0.7)
LLM_TEMPERATURE=

# ── RAG-specific settings (only used when CONTEXT_MODE=rag) ───────────────────
# Number of chunks retrieved per query (default 20 — corpus is ~57 small
# section-sized chunks across 7 docs; 20 covers the relevant sections of 2-3
# docs for cross-topic questions without pulling in the whole corpus)
RAG_K=

# Max HNSWLib distance to include a chunk; lower = stricter (default 0.50)
RAG_SCORE_THRESHOLD=

# Chunk size / overlap for embedding (defaults 1000 / 200)
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=

# ── Generation test settings ─────────────────────────────────────────────────
# Overrides LLM_MODEL_CHAIN just for rag:test-generation / rag:test-generation-all
GEN_TEST_MODEL_CHAIN=

# Judge model chain for rag:test-generation* (single model, no fallback chain,
# by design — see docs/testing-procedure.md §2). Default: deepseek-chat —
# requires DEEPSEEK_API_KEY above. Set to a Gemini model name to judge with
# Gemini instead (reintroduces same-family bias if the generator is also Gemini).
JUDGE_MODEL_CHAIN=

# Ms to wait between LLM calls in the generation test (default 4000)
GEN_TEST_DELAY_MS=

# Temperature for answer generation in the test (default: LLM_TEMPERATURE → 0.7)
GEN_TEST_TEMPERATURE=

# Temperature for the LLM judge (default 0)
GEN_TEST_JUDGE_TEMPERATURE=

# Minimum helpfulness score (1–5) to pass a scenario (default 3)
GEN_TEST_PASS_HELPFULNESS=

# Minimum groundedness score (1–5) to pass a scenario (default 3)
GEN_TEST_PASS_GROUNDEDNESS=

# Minimum safety score (1–5) to pass a scenario (default 3) — gates FAIL like
# helpfulness/groundedness, since this is a safety-critical ADAS tutor.
# Calibration is scored too but is informational only, no GEN_TEST_PASS_CALIBRATION.
GEN_TEST_PASS_SAFETY=

# Max retries per scenario on rate-limit errors (default 1)
GEN_TEST_MAX_RETRIES=

# 1/true enables the live server's query-rewrite step (core/query-rewrite.js)
# for history scenarios in the generation test, RAG mode only. Folded into the
# config hash conditionally: unset keeps existing log hashes byte-stable; set
# forks new log files. Leave unset for the operational campaign; the trap
# suite runs with it on.
GEN_TEST_QUERY_REWRITE=

# ── Query-rewrite test (rag:test-rewrite) ────────────────────────────────────
# Model for the rewrite calls (default gemini-3.1-flash-lite)
REWRITE_TEST_MODEL=

# ── TTS ───────────────────────────────────────────────────────────────────────
# Google Cloud TTS voice (default en-US-Neural2-D)
GOOGLE_TTS_VOICE=

# Server port (default 3000)
PORT=
